# Copy to .env and fill in. Never commit .env (see .gitignore).

# Upstox OAuth (platform layer only; the optitrade quant core needs none of these)
UPSTOX_API_KEY=your_upstox_api_key
UPSTOX_SECRET_KEY=your_upstox_secret_key
OAUTH_REDIRECT_URI=http://localhost:8000/auth/callback

# Session/encryption secret — REQUIRED in production, no fallback
SECRET_KEY=generate_a_long_random_string

# Optional: Upstox Analytics Token — removes the daily login.
#
# The OAuth access token above expires at 03:30 IST every day, so unattended
# capture needs an interactive login each morning and one missed morning costs
# a whole trading day of history. The Analytics Token is generated once from
# the Developer Apps console (Analytics tab), is valid for a year, and needs no
# redirect. When set, the capture path prefers it.
#
# It is read-only (GET only) and cannot place or modify orders — which matches
# this app's own rule that no order-placement path exists, so it is strictly
# less privilege than the OAuth token, not more.
#
# Covers Option Chain, Market Quote, Historical Data and Websocket with no
# static IP. Portfolio/holdings additionally require whitelisting your IP in
# the console; without that, those endpoints still need the OAuth token.
UPSTOX_ANALYTICS_TOKEN=

# Optional: token storage location (defaults to home directory)
TOKEN_STORAGE_PATH=~/.upstox_tokens.json

# Environment
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO
