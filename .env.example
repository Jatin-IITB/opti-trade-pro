# Copy to .env and fill in. Never commit .env (see .gitignore).

# Upstox OAuth (platform layer only; the optitrade quant core needs none of these)
UPSTOX_API_KEY=your_upstox_api_key
UPSTOX_SECRET_KEY=your_upstox_secret_key
OAUTH_REDIRECT_URI=http://localhost:8000/auth/callback

# Session/encryption secret — REQUIRED in production, no fallback
SECRET_KEY=generate_a_long_random_string

# Optional: token storage location (defaults to home directory)
TOKEN_STORAGE_PATH=~/.upstox_tokens.json

# Environment
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO
